<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Identidade do pacote publicado pelo fork. O PackageId é outro de propósito: este pacote não é
    o BoletoNetCore do nuget.org, e um id igual com conteúdo diferente é a forma mais rápida de
    alguém restaurar uma coisa achando que restaurou outra.

    A versão diz de onde veio e o que foi acrescentado: 3.0.1.563 é o master do upstream um commit
    além do 3.0.1.562 publicado em 24/08/2026, e `gecontrol.N` numera os nossos patches sobre ele.
    Ela é imutável — cada boleto grava a versão que o gerou (MaestroBoleto §28.2), e reaproveitar
    um número tornaria esse registro mentira.
  -->
  <PropertyGroup>
    <PackageId>Gecontrol.BoletoNetCore</PackageId>
    <Title>Gecontrol.BoletoNetCore</Title>
    <Version>3.0.1.563-gecontrol.1</Version>
    <Authors>BoletoNetCore; Gecontrol Sistemas</Authors>
    <Company>Gecontrol Sistemas</Company>
    <PackageProjectUrl>https://github.com/gecontrolsistemas/BoletoNetCore/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gecontrolsistemas/BoletoNetCore.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>gecontrol</RepositoryBranch>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>PACOTE.md</PackageReadmeFile>
    <Description>
      Fork de BoletoNetCore (github.com/BoletoNet/BoletoNetCore, MIT) mantido pela Gecontrol Sistemas.
      O branch `master` do fork espelha o upstream; este pacote sai do branch `gecontrol`, que carrega
      os patches nossos sobre ele — cada um candidato a PR para o upstream.
      Patches nesta versão: data e hora de geração do arquivo de remessa informadas por quem gera,
      em vez de lidas do relógio do processo (IBanco.DataGeracao).
    </Description>
    <PackageReleaseNotes>
      Base: upstream/master em 01/09/2026, um commit além do 3.0.1.562 do nuget.org.
      gecontrol.1: IBanco.DataGeracao — a data de gravação da remessa e o nome do arquivo deixam de
      vir de DateTime.Now. Sem atribuição o comportamento é o de antes, byte a byte.
    </PackageReleaseNotes>
    <PackageTags>boleto cnab banco</PackageTags>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ApplicationIcon />
    <OutputType>Library</OutputType>
    <StartupObject />
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!--
      PDB dentro da dll e fontes junto: quem depura uma diferença de byte numa remessa entra na
      biblioteca sem servidor de símbolos, que é exatamente a hora em que ele não existe.
    -->
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Imagens\*" />
    <EmbeddedResource Include="BoletoImpressao\**\*.css" />
    <EmbeddedResource Include="BoletoImpressao\**\*.jpg" />
    <EmbeddedResource Include="BoletoImpressao\**\*.jpeg" />
    <EmbeddedResource Include="BoletoImpressao\**\*.html" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="BoletoImpressao\Parts\Pix.html" />
    <None Remove="Imagens\085.jpg" />
    <None Include="PACOTE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.6" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.3" />
    <PackageReference Include="System.Net.Http.Json" Version="7.0.1" />
  </ItemGroup>


</Project>
